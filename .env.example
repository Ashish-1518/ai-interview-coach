APP_NAME=AI Interview Coach
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173

# Local Docker Compose example:
# postgresql+psycopg://interview_coach:interview_coach_password@db:5432/interview_coach
DATABASE_URL=postgresql+psycopg://interview_coach:interview_coach_password@localhost:5432/interview_coach

LOG_LEVEL=INFO

JWT_SECRET_KEY=change-this-secret-in-your-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_DIR=storage
MAX_RESUME_UPLOAD_SIZE_MB=5

# Leave AI_API_KEY empty to run the interview engine on the question bank only.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
