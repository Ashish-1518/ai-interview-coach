# ─────────────────────────────────────────────────────────
# Production environment — copy to .env and fill in values
# ─────────────────────────────────────────────────────────

APP_NAME=AI Interview Coach
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=https://your-frontend-domain.onrender.com

# PostgreSQL — use the Internal Database URL from Render dashboard
DATABASE_URL=postgresql+psycopg://user:password@host:5432/interview_coach

LOG_LEVEL=WARNING

# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE-ME-generate-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_DIR=storage
MAX_RESUME_UPLOAD_SIZE_MB=5

# AI provider — leave AI_API_KEY empty to disable LLM features
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
